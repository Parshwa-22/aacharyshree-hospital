# Supply these as hosting-provider environment variables. Never commit real values.
PORT=8080
DB_URL=jdbc:mysql://localhost:3306/aacharyshree_hospital?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=hospital_app
DB_PASSWORD=replace-with-a-long-unique-password
DB_DDL_AUTO=validate
SHOW_SQL=false
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
MAIL_USERNAME=hospital@example.com
MAIL_PASSWORD=replace-with-gmail-app-password
MAIL_FROM_NAME=Aacharyshree Hospital
MAIL_LOGO_URL=https://example.com/logo.png
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION_MS=86400000
ADMIN_REGISTRATION_SECRET=replace-with-a-separate-long-random-secret
